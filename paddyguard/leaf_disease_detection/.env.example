MODEL_PATH=models/PaddyGuard_active_learning_round2.pth
DATABASE_URL=sqlite:///./data/paddyguard.db
FRONTEND_ORIGIN=http://localhost:5173,https://your-production-frontend-domain.com
OOD_ENERGY_THRESHOLD=5.0
UNCERTAIN_THRESHOLD=0.70
SUPER_ADMIN_USERNAME=replace_with_super_admin_username
SUPER_ADMIN_PASSWORD=replace_with_secure_password
SECRET_KEY=replace_with_random_secret_key
AUTH_TOKEN_MAX_AGE_SECONDS=28800

MIN_FINE_TUNE_SAMPLES=3
FINE_TUNE_EPOCHS=3
TEST_DATASET_PATH=data/test_dataset
MAX_REJECTED_CANDIDATES=3
MAX_BACKUPS=2
TRAINING_LOG_RETENTION_DAYS=14

# MongoDB and Cloudinary Configurations
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

